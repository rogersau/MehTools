<Window x:Class="JamesTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:JamesTools" ui:WindowTheme.Enabled="True"
        Title="Meh Tools" Width="1140" Height="780" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing" StateChanged="Window_StateChanged"
        Loaded="MainWindow_Loaded" PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="MoreOptions" TargetType="Expander" BasedOn="{StaticResource DarkExpander}">
            <Setter Property="Padding" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="AvailableAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GamePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#141C24" BorderBrush="#2B3841" BorderThickness="0,0,1,0">
            <Grid Margin="16,24,14,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Meh Tools" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" Margin="8,0,0,20"/>
                <ListBox x:Name="Navigation" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}"
                         SelectionChanged="Navigation_SelectionChanged" SelectedIndex="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Padding" Value="10,11"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="NavBg" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#293C43"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#23313A"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}"/><TextBlock Text="Games" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem x:Name="RecordingNavigationItem"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" Style="{StaticResource NavIcon}"/><TextBlock Text="Recording" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource NavIcon}"/><TextBlock Text="Display &amp; Power" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Performance" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="Sessions" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                </ListBox>
                <Button x:Name="SettingsNavButton" Grid.Row="2" Click="SettingsNav_Click" Margin="0,0,0,12" Padding="10,10"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Grid.Row="3" Background="#1D2D30" CornerRadius="8" Padding="13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#6F808A" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="STATUS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SidebarStatus" Text="Loading…" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" Text="Overview" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="SaveStatePill" Grid.Column="1" CornerRadius="12" Padding="10,4" Background="#1D2D30" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="SaveStateBadge" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="0">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style></TabControl.Resources>

                <!-- 0: Overview -->
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Background="#1D3434" BorderBrush="#34554D" BorderThickness="1" CornerRadius="9" Padding="22" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="WATCHING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock x:Name="OverviewHeadline" Text="Off" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,3"/>
                                        <TextBlock Text="Automatically applies your recording, colour, and power settings when a game starts." Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <Button x:Name="AutomationButton" Grid.Column="1" Content="Start watching" Style="{StaticResource AccentButton}"
                                            VerticalAlignment="Center" Margin="16,0,0,0" Click="ToggleAutomation_Click"/>
                                </Grid>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,0,-14,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel>
                                    <TextBlock Text="ACTIVE GAME" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="StatusGame" Text="None" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RecordingEnabled}" Click="CaptureEnabled_Click" Margin="0" ToolTip="Toggle automatic OBS capture"/>
                                        <TextBlock Text="OBS CAPTURE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="StatusRecording" Text="Off" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VibranceEnabled}" Margin="0" ToolTip="Toggle NVIDIA Digital Vibrance"/>
                                        <TextBlock Text="COLOURS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="StatusVibrance" Text="Off" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PowerEnabled}" Click="PowerEnabled_Click" Margin="0" ToolTip="Toggle Windows power plan switching"/>
                                        <TextBlock Text="POWER PLAN" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="StatusPower" Text="Off" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recent activity" FontSize="16" FontWeight="SemiBold"/>
                                    <ListBox x:Name="ActivityList" Margin="0,12,0,0" MaxHeight="150" BorderThickness="0"
                                             Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Expander Header="Setup checks" Style="{StaticResource MoreOptions}">
                                    <StackPanel>
                                        <Button Content="Run setup check" Click="RefreshHealth_Click" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="HealthSummary" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 1: Games -->
                <TabItem Header="Games">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Your games" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Add a game and choose what happens when you play it." Style="{StaticResource Hint}" Margin="0,5,0,16"/>
                                <TextBlock Margin="0,0,0,10" Text="No games yet. Launch a game or browse for its .exe to add one.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=GameGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DataGrid x:Name="GameGrid" ItemsSource="{Binding Games}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" MinHeight="145"
                                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36"
                                          LoadingRow="GameGrid_LoadingRow" SelectionChanged="GameGrid_SelectionChanged" CellEditEnding="GameGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="GAME NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" MinWidth="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="GAME FILE" Binding="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" Width="2.4*" MinWidth="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding ExecutablePath}"/>
                                                    <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="OBS CAPTURE" Width="96" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Record, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                              Click="GameObsCapture_Click" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              AutomationProperties.Name="Automatic OBS capture"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="COLOURS" Binding="{Binding UseVibrance, UpdateSourceTrigger=PropertyChanged}" Width="94">
                                            <DataGridCheckBoxColumn.ElementStyle>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource DataGridFocusVisual}"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.ElementStyle>
                                            <DataGridCheckBoxColumn.EditingElementStyle>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource DataGridFocusVisual}"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.EditingElementStyle>
                                        </DataGridCheckBoxColumn>
                                        <DataGridComboBoxColumn x:Name="MatchModeColumn" Header="MATCH" SelectedItemBinding="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}" Width="90" Visibility="Collapsed"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <Button Content="Add game…" Click="AddRunningGame_Click" Style="{StaticResource AccentButton}"/>
                                    <Button Content="Remove game" Click="RemoveGame_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=GameGrid}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Expander IsExpanded="False" Margin="0,14,0,0">
                                    <Expander.Style>
                                        <Style TargetType="Expander" BasedOn="{StaticResource DarkExpander}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=GameGrid}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <Expander.Header>
                                        <TextBlock Text="Per-game overrides" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    </Expander.Header>
                                    <Border Background="#162029" BorderBrush="#2B3841" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0"
                                            DataContext="{Binding SelectedItem, ElementName=GameGrid}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="How to match this game" FontWeight="SemiBold"/>
                                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,6,0,0">
                                                    <ComboBoxItem Content="Exact file path" Tag="path"/>
                                                    <ComboBoxItem Content="Process name only" Tag="name"/>
                                                    <ComboBoxItem Content="Any game in folder" Tag="folder"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="Power plan" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GamePowerPlanOptions}"
                                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                                          SelectedValue="{Binding PowerPlanId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,14,0">
                                                <TextBlock Text="Colour strength (%)" FontWeight="SemiBold"/>
                                                <TextBox Width="100" HorizontalAlignment="Left" Margin="0,6,0,0" MaxLength="3"
                                                         Text="{Binding VibrancePercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         PreviewTextInput="WholeNumber_PreviewTextInput" DataObject.Pasting="WholeNumber_Pasting"
                                                         ToolTip="0–100. Blank uses global in-game vibrance."/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                                <TextBlock Text="Stop delay (seconds)" FontWeight="SemiBold"/>
                                                <TextBox Width="100" HorizontalAlignment="Left" Margin="0,6,0,0" MaxLength="3"
                                                         Text="{Binding RecordingStopDelaySeconds, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         PreviewTextInput="WholeNumber_PreviewTextInput" DataObject.Pasting="WholeNumber_Pasting"
                                                         ToolTip="0–120. Blank uses global default."/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,14,0">
                                                <TextBlock Text="Capture mode" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CaptureModeOptions}"
                                                          DisplayMemberPath="Name" SelectedValuePath="Value"
                                                          SelectedValue="{Binding CaptureMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          SelectionChanged="GameOverrideChanged"
                                                          Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="180"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                                                <TextBlock Text="Replay length (seconds)" FontWeight="SemiBold"/>
                                                <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding ReplayBufferSeconds, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         PreviewTextInput="WholeNumber_PreviewTextInput" DataObject.Pasting="WholeNumber_Pasting"
                                                         TextChanged="GameOverrideChanged" Margin="0,6,0,0" ToolTip="15–600. Blank uses global default."/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                                <TextBlock Text="Recording folder override" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding RecordingDirectory, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" TextChanged="GameOverrideChanged" Margin="0,6,0,0" ToolTip="Blank uses global recording folder."/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                                <TextBlock x:Name="EffectiveOptionsSummary" Text="Select a game to preview resolved values." TextWrapping="Wrap" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </StackPanel></Border>
                            <Border x:Name="GameSteamHighlightsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Steam highlights" FontSize="16" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="GameSteamAutoHighlights" Style="{StaticResource ToggleSwitch}" Content="Make a highlights video after this game’s session ends"
                                              Click="GameSteamAutoHighlights_Click" Margin="0,10,0,0"/>
                                    <TextBlock Text="Uses Steam’s timeline events and footage to export an MP4 montage without OBS."
                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                    <Button x:Name="OpenSteamHighlightTiming" Content="Clip timing and event types…" Click="OpenSteamHighlightTiming_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2: Recording -->
                <TabItem Header="Recording">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Steam Game Recording" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="Review and export highlights directly from Steam’s event timeline." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                <Button Content="Steam highlights…" Click="SteamWardogs_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/>
                                <Expander x:Name="SteamHighlightOptions" Header="Highlight timing and folders" Style="{StaticResource MoreOptions}" Margin="0,10,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <WrapPanel>
                                            <TextBlock Text="Seconds before" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBox x:Name="SteamBeforeBox" Width="52" MaxLength="2" Margin="0,0,16,0"
                                                     AutomationProperties.Name="Seconds before each Steam event"
                                                     PreviewTextInput="WholeNumber_PreviewTextInput" DataObject.Pasting="WholeNumber_Pasting"
                                                     Text="{Binding SteamHighlights.BeforeSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Seconds after" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBox x:Name="SteamAfterBox" Width="52" MaxLength="2"
                                                     AutomationProperties.Name="Seconds after each Steam event"
                                                     PreviewTextInput="WholeNumber_PreviewTextInput" DataObject.Pasting="WholeNumber_Pasting"
                                                     Text="{Binding SteamHighlights.AfterSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                        </WrapPanel>
                                        <TextBlock Text="Event types for automatic highlights" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="SteamAutoKills" Content="Kills" IsChecked="{Binding SteamHighlights.IncludeKills}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Kill assists" IsChecked="{Binding SteamHighlights.IncludeAssists}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Revives and respawns" IsChecked="{Binding SteamHighlights.IncludeRevives}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Other events" IsChecked="{Binding SteamHighlights.IncludeOther}"/>
                                        </WrapPanel>
                                        <TextBlock Text="Steam recording folder (blank to auto-detect)" Margin="0,10,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseSteamRecordingFolder_Click" Margin="8,0,0,0"/>
                                            <TextBox x:Name="SteamRecordingFolderBox" AutomationProperties.Name="Steam recording folder" Text="{Binding SteamHighlights.RecordingFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <TextBlock Text="Save highlights to (blank for Videos → Meh Tools → Steam Highlights)" TextWrapping="Wrap" Margin="0,10,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseSteamHighlightsFolder_Click" Margin="8,0,0,0"/>
                                            <TextBox x:Name="SteamOutputFolderBox" AutomationProperties.Name="Steam highlights output folder" Text="{Binding SteamHighlights.OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>
                                <TextBlock x:Name="SteamHighlightStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <CheckBox x:Name="CaptureEnabledBox" Style="{StaticResource ToggleSwitch}" Content="Start OBS automatically when I play" IsChecked="{Binding RecordingEnabled}" Click="CaptureEnabled_Click" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ObsSetupStatus" Style="{StaticResource Hint}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,2,0,0">
                                    <Button x:Name="OpenVideosButton" Content="Open videos folder" Click="OpenRecordings_Click" Style="{StaticResource AvailableAction}" IsEnabled="False"/>
                                    <Button Content="Open OBS" Click="OpenObs_Click"/>
                                    <Button Content="Check OBS setup" Click="TestObs_Click"/>
                                </WrapPanel>
                                <Expander x:Name="ObsSetupOptions" Header="OBS paths and portable mode" Style="{StaticResource MoreOptions}" Margin="0,10,0,0"><StackPanel>
                                    <TextBlock Text="OBS program" Margin="0,6,0,6" FontWeight="SemiBold"/>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseObs_Click" Margin="8,0,0,0"/><TextBox Text="{Binding ObsExecutablePath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                    <TextBlock Text="Save videos to" Margin="0,12,0,6" FontWeight="SemiBold"/>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseRecordingFolder_Click" Margin="8,0,0,0"/><TextBox Text="{Binding RecordingDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                    <TextBlock Text="OBS configuration folder" Margin="0,12,0,6" FontWeight="SemiBold"/>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseObsConfig_Click" Margin="8,0,0,0"/><TextBox Text="{Binding ObsConfigRoot, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="OBS configuration folder"/></DockPanel>
                                    <CheckBox Content="Use OBS portable mode" IsChecked="{Binding ObsPortable}" Margin="0,10,0,2"/>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <Expander Header="Live OBS controls" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ObsPasswordLabel" Text="OBS password" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <PasswordBox x:Name="ObsWebSocketPasswordBox" Width="170"/>
                                        <Button x:Name="ObsConnectButton" Content="Connect to OBS" Click="ObsConnect_Click" Margin="8,0,0,0"/>
                                        <Button x:Name="ObsDisconnectButton" Content="Disconnect" Click="ObsDisconnect_Click" Visibility="Collapsed" Margin="0"/>
                                    </WrapPanel>
                                    <WrapPanel x:Name="ObsConnectionOptions" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <CheckBox x:Name="ObsRememberPasswordBox" Content="Remember password" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ObsWebSocketPortBox" Width="70" Text="{Binding ObsWebSocketPort, UpdateSourceTrigger=PropertyChanged}" TextChanged="ObsPort_Changed" Margin="0,0,10,0"/>
                                        <Button x:Name="ObsForgetPasswordButton" Content="Forget saved password" Click="ObsForgetPassword_Click" Visibility="Collapsed"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ObsConnectionStatus" Text="Not connected" FontWeight="SemiBold" Margin="0,12,0,3"/>
                                    <TextBlock x:Name="ObsCredentialStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="ObsLiveDetails" Visibility="Collapsed">
                                        <TextBlock Text="Recording" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="ObsOutputState" Text="Unknown" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,9"/>
                                        <TextBlock Text="Replay buffer" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="ObsReplayState" Text="Unknown" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,9"/>
                                        <WrapPanel>
                                            <TextBlock Text="Duration: " Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="ObsDuration" Text="—" Margin="0,0,22,0"/>
                                            <TextBlock Text="Data written: " Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="ObsDataWritten" Text="—"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="ObsStartButton" Content="Start recording" Click="ObsStart_Click" IsEnabled="False"/>
                                            <Button x:Name="ObsStopButton" Content="Stop recording" Click="ObsStop_Click" IsEnabled="False"/>
                                            <Button x:Name="ObsPauseButton" Content="Pause recording" Click="ObsPause_Click" IsEnabled="False"/>
                                            <Button x:Name="ObsResumeButton" Content="Resume recording" Click="ObsResume_Click" IsEnabled="False"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button x:Name="ObsStartReplayButton" Content="Start replay buffer" Click="ObsStartReplay_Click" IsEnabled="False"/>
                                            <Button x:Name="ObsStopReplayButton" Content="Stop replay buffer" Click="ObsStopReplay_Click" IsEnabled="False"/>
                                            <Button x:Name="ObsSaveClipButton" Content="Save clip" Click="ObsSaveClip_Click" IsEnabled="False"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="ObsSavedOutputs" Visibility="Collapsed">
                                        <TextBlock Text="Last saved recording" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,2"/>
                                        <DockPanel>
                                            <Button Style="{StaticResource AvailableAction}" x:Name="ObsOpenLastButton" DockPanel.Dock="Right" Content="Open file" Click="ObsOpenLast_Click" IsEnabled="False"/>
                                            <TextBlock x:Name="ObsLastRecording" Text="None reported" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </DockPanel>
                                        <TextBlock Text="Last saved clip" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,2"/>
                                        <DockPanel>
                                            <Button Style="{StaticResource AvailableAction}" x:Name="ObsOpenLastClipButton" DockPanel.Dock="Right" Content="Open file" Click="ObsOpenLastClip_Click" IsEnabled="False"/>
                                            <TextBlock x:Name="ObsLastClip" Text="None reported" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="ObsRemoteError" TextWrapping="Wrap" Foreground="#D98272" Margin="0,7,0,0" Visibility="Collapsed"/>
                                </StackPanel></Expander>
                                <Expander Header="Capture settings" Margin="0,12,0,0" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Wait before stopping (seconds)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox x:Name="StopDelayBox" Width="56" Text="{Binding RecordingStopDelaySeconds, UpdateSourceTrigger=PropertyChanged}" ToolTip="0–120 seconds."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Replay buffer length (seconds)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox x:Name="ReplayBufferSecondsBox" Width="64" Text="{Binding ReplayBufferSeconds, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                                                 PreviewTextInput="WholeNumber_PreviewTextInput" DataObject.Pasting="WholeNumber_Pasting"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Save clip hotkey" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox x:Name="SaveClipHotkeyBox" Width="150" Text="{Binding SaveClipHotkey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: Ctrl+Alt+F10 (leave blank to disable)"/>
                                    </StackPanel>
                                </StackPanel></Expander>
                                <Expander Header="Storage" Margin="0,12,0,0" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <ComboBox x:Name="RecordingStorageTarget" DisplayMemberPath="Label" SelectionChanged="RecordingStorageTarget_SelectionChanged" Margin="0,0,0,8"/>
                                    <TextBlock Text="Base folder" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="StorageBasePath" Text="—" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <TextBlock Text="Planned capture folder" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="StoragePlannedPath" Text="—" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="StorageCapacityText" TextWrapping="Wrap" MaxWidth="600" Text="Space: unknown" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="Refresh" Click="RefreshStorageVisibility_Click"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="LowStorageWarningBox" Content="Warn when free space is below" IsChecked="{Binding LowStorageWarningsEnabled}" Margin="0,12,0,5"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=LowStorageWarningBox, Converter={StaticResource BoolVisibility}}">
                                        <TextBox Width="76" Text="{Binding LowStorageThresholdGiB, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="GiB" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="OrganiseCapturesBox" Content="Organise new captures by game and date" IsChecked="{Binding OrganiseCapturesByGameAndDate}" Checked="OrganiseCapturesBox_Changed" Unchecked="OrganiseCapturesBox_Changed" Margin="0,12,0,0"/>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 3: Display & Power (merged Colours + Power) -->
                <TabItem Header="Display &amp; Power">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="NVIDIA Digital Vibrance" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Boost colours automatically while playing selected games." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Change colours for selected games" IsChecked="{Binding VibranceEnabled}"/>
                                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="DESKTOP" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DesktopVibrance, StringFormat={}{0}%}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DesktopVibrance}" Margin="0,6,0,8"/>
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="IN GAME" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GameVibrance, StringFormat={}{0}%}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GameVibrance}" Margin="0,6,0,6"/>
                                <Expander Header="Display and focus settings" Style="{StaticResource MoreOptions}" Margin="0,10,0,0"><StackPanel>
                                    <CheckBox Content="Pause colours when HDR is on" IsChecked="{Binding DisableVibranceWhenHdr}"/>
                                    <TextBlock Text="Apply to" FontWeight="SemiBold" Margin="0,14,0,5"/>
                                    <ComboBox x:Name="VibranceTargetBox" ItemsSource="{Binding VibranceTargetOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding VibranceTargetMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedValue, ElementName=VibranceTargetBox}" Value="SelectedDisplay">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                        <ComboBox x:Name="VibranceDisplayBox" Width="300" ItemsSource="{Binding VibranceDisplayOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="DeviceName" SelectedValue="{Binding VibranceSelectedDisplay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Refresh displays" Click="RefreshVibranceDisplays_Click" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                    <CheckBox Content="Apply game colours only while the game is focused" IsChecked="{Binding VibranceOnlyWhenFocused}" Margin="0,10,0,0"/>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Windows power plans" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Switch to your gaming plan automatically when a game launches." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Switch power plans when playing" IsChecked="{Binding PowerEnabled}" Click="PowerEnabled_Click"/>
                                <Expander x:Name="PowerPlanOptions" Header="Plans and game launchers" Style="{StaticResource MoreOptions}" Margin="0,10,0,0"><StackPanel>
                                    <TextBlock Text="Desktop plan" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="DesktopPlanBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DesktopPowerPlan}"/>
                                    <TextBlock Text="Gaming plan" Margin="0,12,0,6" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="GamingPlanBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding GamingPowerPlan}"/>
                                    <CheckBox Content="Switch for all detected Steam games" IsChecked="{Binding PowerForAllSteamGames}" Margin="0,10,0,0"/>
                                    <TextBlock Text="Also detect games from" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <WrapPanel>
                                        <CheckBox Content="Epic" IsChecked="{Binding DetectEpicGames}" Margin="0,4,12,4"/>
                                        <CheckBox Content="GOG" IsChecked="{Binding DetectGogGames}" Margin="0,4,12,4"/>
                                        <CheckBox Content="EA app" IsChecked="{Binding DetectEaGames}" Margin="0,4,12,4"/>
                                        <CheckBox Content="Ubisoft" IsChecked="{Binding DetectUbisoftGames}" Margin="0,4,12,4"/>
                                        <CheckBox Content="Xbox (PC)" IsChecked="{Binding DetectXboxGames}" Margin="0,4,12,4"/>
                                    </WrapPanel>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4: Performance -->
                <TabItem Header="Performance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Stutter Investigator…" Click="StutterInvestigator_Click" Margin="8,0,0,0"/>
                                    <TextBlock Text="Performance log" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Record frame timing, CPU/GPU telemetry, and stutter evidence into a report you can inspect or paste straight into an AI." Style="{StaticResource Hint}" Margin="0,5,0,10"/>
                                <TextBlock Text="Game" FontWeight="SemiBold" Margin="0,0,0,6" Visibility="{Binding Visibility, ElementName=PerformanceGame}"/>
                                <ComboBox x:Name="PerformanceGame" ItemsSource="{Binding Games}" DisplayMemberPath="Name" SelectedIndex="0" Style="{StaticResource GamePicker}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="StartPerformanceButton" Content="Start log" Style="{StaticResource AccentButton}" Click="StartPerformance_Click"/>
                                    <Button x:Name="StopPerformanceButton" Content="Stop and save" Style="{StaticResource AccentButton}" Click="StopPerformance_Click" IsEnabled="False" Visibility="Collapsed"/>
                                    <Button Content="Open saved report…" Click="OpenPerformanceReport_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="PerformanceStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="PerformanceMarkerOptions" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Button x:Name="AddMarkerButton" Content="Add marker" IsEnabled="False" Click="AddMarker_Click"/>
                                    <TextBox x:Name="MarkerNoteBox" Width="240" ToolTip="Optional marker note"/>
                                </WrapPanel>
                                <WrapPanel x:Name="PerformanceReportActions" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Button x:Name="CopyPerformanceForAiButton" Content="Copy for AI" Style="{StaticResource AccentButton}" IsEnabled="False" Click="CopyPerformanceForAi_Click" ToolTip="Copy full Markdown report to clipboard for pasting into an LLM"/>
                                    <Button x:Name="ViewPerformanceReportButton" Content="View report timeline" IsEnabled="False" Click="ViewPerformanceReport_Click"/>
                                    <ui:ActionMenu Content="Report actions">
                                        <ui:ActionMenu.ContextMenu><ContextMenu>
                                            <MenuItem x:Name="OpenLatestReportButton" Header="Open report file" Click="OpenLatestReport_Click" IsEnabled="False"/>
                                            <MenuItem x:Name="SavePerformanceButton" Header="Export a copy…" IsEnabled="False" Click="SavePerformance_Click"/>
                                            <MenuItem x:Name="CompareCurrentBaselineButton" Header="Compare with baseline" IsEnabled="False" Click="CompareCurrentBaseline_Click"/>
                                        </ContextMenu></ui:ActionMenu.ContextMenu>
                                    </ui:ActionMenu>
                                </WrapPanel>
                                <Expander x:Name="PerformanceContextOptions" Header="Game settings and notes" Style="{StaticResource MoreOptions}" Margin="0,12,0,0"><StackPanel>
                                    <TextBlock Text="Game settings and test scene (optional)" FontWeight="SemiBold" Margin="0,10,0,6"/>
                                    <TextBox x:Name="PerformanceSetup" AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="4000" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="Symptoms and target FPS (optional)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                    <TextBox x:Name="PerformanceNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="68" MaxLength="4000" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <Expander Header="Retest and compare" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <WrapPanel>
                                        <Button Content="Choose baseline…" Click="ChooseBaselineReport_Click"/>
                                        <Button x:Name="ClearBaselineButton" Content="Clear baseline" Click="ClearBaselineReport_Click" Style="{StaticResource AvailableAction}" IsEnabled="False"/>
                                        <Button Content="Compare two reports…" Click="ComparePerformance_Click"/>
                                    </WrapPanel>
                                    <StackPanel x:Name="RetestOptions" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock x:Name="BaselineReportPathBox" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="What changed in this retest?" Margin="0,8,0,5"/>
                                        <TextBox x:Name="RetestChangeBox" MaxLength="500" ToolTip="Example: Changed shadow quality from High to Medium"/>
                                    </StackPanel>
                                </StackPanel></Expander>
                                <Expander Header="Capture settings" Margin="0,12,0,0" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <TextBlock Text="PresentMon override (blank uses bundled copy)" FontWeight="SemiBold" Margin="0,10,0,6"/>
                                    <DockPanel>
                                        <Button Content="Use bundled" DockPanel.Dock="Right" Click="ClearPresentMon_Click"/>
                                        <Button Content="Browse…" DockPanel.Dock="Right" Click="BrowsePresentMon_Click"/>
                                        <TextBox x:Name="PresentMonPath" Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <CheckBox x:Name="NetworkDiagnosticsBox" Content="Include ICMP ping checks in performance logs" IsChecked="{Binding NetworkDiagnosticsEnabled}" Margin="0,10,0,0"/>
                                    <StackPanel Visibility="{Binding IsChecked, ElementName=NetworkDiagnosticsBox, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
                                        <TextBlock Text="Up to three hostnames or IP addresses (one per line)." Style="{StaticResource Hint}"/>
                                        <TextBox Text="{Binding NetworkTargets, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="Faster GPU and system sampling (~1s)" IsChecked="{Binding Diagnostics.FastGpuPolling}" Margin="0,8,0,0"/>
                                    <CheckBox Content="ETW hard-fault tracing (requires admin privileges)" IsChecked="{Binding Diagnostics.AdvancedHardFaultTracing}" Margin="0,4,0,0"/>
                                    <WrapPanel Margin="0,10,0,8">
                                        <TextBlock Text="Warm-up (s)" VerticalAlignment="Center"/><TextBox Width="65" Margin="6,0,15,0" Text="{Binding Diagnostics.WarmupSeconds}"/>
                                        <TextBlock Text="Stutter threshold (ms)" VerticalAlignment="Center"/><TextBox Width="75" Margin="6,0,15,0" Text="{Binding Diagnostics.StutterThresholdMs}"/>
                                        <TextBlock Text="Target FPS" VerticalAlignment="Center"/><TextBox Width="65" Margin="6,0,0,0" Text="{Binding Diagnostics.TargetFps}"/>
                                    </WrapPanel>
                                    <ItemsControl x:Name="DiagnosticConditionsFields"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <TextBlock Text="Stutter marker hotkey" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="StutterMarkerHotkeyBox" Width="145" Text="{Binding StutterMarkerHotkey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Default Ctrl+Alt+F9; blank disables"/>
                                    </WrapPanel>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 5: Sessions -->
                <TabItem Header="Sessions">
                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel x:Name="SessionSearchPanel" Grid.ColumnSpan="2" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="Search sessions" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
                            <TextBox x:Name="SessionsSearch" AutomationProperties.Name="Search sessions" ToolTip="Search by game, date or notes" TextChanged="SessionsSearch_TextChanged"/>
                        </StackPanel>
                        <ListBox x:Name="SessionsList" Grid.Row="1" Margin="0,0,14,0" SelectionChanged="SessionsList_SelectionChanged">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding GameName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SessionsList}" Value="False">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <Border x:Name="SessionDetailsCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
                                    <TextBlock x:Name="SessionDetailGame" Text="Select a session" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SessionDetailWhen" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="SessionDetailDuration" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="SessionSteamKd" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SessionDetailStatus" Style="{StaticResource Hint}" Margin="0,3,0,12"/>
                                    <CheckBox x:Name="SessionFavourite" Content="Favourite"/>
                                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,12,0,5"/>
                                    <TextBox x:Name="SessionNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="86" MaxLength="4000" VerticalScrollBarVisibility="Auto"/>
                                    <Button Content="Save notes" Click="SaveSessionDetails_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel></Border>
                                <Border x:Name="SessionFilesCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
                                    <TextBlock Text="Files" FontSize="16" FontWeight="SemiBold"/>
                                    <ListBox x:Name="SessionAttachments" Height="145" Margin="0,8,0,8" DisplayMemberPath="Label" SelectionChanged="SessionAttachments_SelectionChanged"/>
                                    <WrapPanel>
                                        <Button x:Name="SessionSteamHighlightsButton" Content="Make Steam highlights…" Click="SessionSteamHighlights_Click" Visibility="Collapsed"/>
                                        <Button Content="Attach file…" Click="AttachSessionFile_Click"/>
                                        <Button x:Name="OpenSessionFileButton" Content="Open file" Click="OpenSessionFile_Click" IsEnabled="False" Style="{StaticResource AvailableAction}"/>
                                        <ui:ActionMenu x:Name="SessionFileActions" Content="File actions" Visibility="Collapsed">
                                            <ui:ActionMenu.ContextMenu><ContextMenu>
                                                <MenuItem x:Name="CopySessionReportButton" Header="Copy report for AI" Click="CopySessionReportForAi_Click" IsEnabled="False"/>
                                                <MenuItem x:Name="ViewSessionReportButton" Header="View report timeline" Click="ViewSessionReport_Click" IsEnabled="False"/>
                                                <MenuItem x:Name="ShowSessionFileButton" Header="Show in folder" Click="ShowSessionFile_Click" IsEnabled="False"/>
                                                <MenuItem x:Name="CompareSessionButton" Header="Compare with previous session" Click="CompareSession_Click" IsEnabled="False"/>
                                            </ContextMenu></ui:ActionMenu.ContextMenu>
                                        </ui:ActionMenu>
                                    </WrapPanel>
                                </StackPanel></Border>
                                <TextBlock x:Name="SessionsStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- 6: Settings (pinned footer nav) -->
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Keep running in the tray when I close the window" IsChecked="{Binding MinimizeToTray}" Margin="0,8,0,4"/>
                                <CheckBox Content="Minimize to tray instead of taskbar" IsChecked="{Binding TrayOnMinimize}" Margin="0,6,0,4"/>
                                <CheckBox Content="Show tray notifications" IsChecked="{Binding ShowNotifications}"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <Expander Header="Game detection interval" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Check for games every" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="PollSecondsBox" Width="50" Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged}" ToolTip="2–30 seconds."/><TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                                </StackPanel></Expander>
                                <Expander Header="Test setup" Margin="0,12,0,0" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Test OBS setup" Click="TestObs_Click"/>
                                        <Button Content="Test colours" Click="TestVibrance_Click"/>
                                        <Button Content="Test power plan" Click="TestPower_Click"/>
                                    </StackPanel>
                                </StackPanel></Expander>
                                <Expander Header="Automatic actions" Margin="0,12,0,0" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <CheckBox x:Name="CloseAppsBox" Content="Close selected apps when a game starts" IsChecked="{Binding CloseAppsOnGameLaunch}"/>
                                    <StackPanel Visibility="{Binding IsChecked, ElementName=CloseAppsBox, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="One app name or executable per line." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                        <TextBox x:Name="AppsToCloseBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="Open videos folder after recording stops" IsChecked="{Binding OpenRecordingsAfterStop}" Margin="0,8,0,0"/>
                                </StackPanel></Expander>
                                <Expander Header="Back up settings" Margin="0,12,0,0" Style="{StaticResource MoreOptions}"><StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Export settings…" Click="ExportSettings_Click"/>
                                        <Button Content="Import settings…" Click="ImportSettings_Click"/>
                                    </StackPanel>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="2" BorderBrush="#2D3C46" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=StatusNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="StatusNotice" Style="{StaticResource Hint}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
