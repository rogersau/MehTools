<Window x:Class="JamesTools.PerformanceOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:JamesTools" ui:WindowTheme.Enabled="True"
        Title="Performance monitor" Width="260" SizeToContent="Height" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#E810161D" Foreground="#EDF4F4">
    <Border BorderBrush="#52656C" BorderThickness="1" Padding="12">
        <StackPanel>
            <DockPanel MouseLeftButtonDown="Drag_MouseLeftButtonDown" LastChildFill="True">
                <Button Content="×" DockPanel.Dock="Right" Click="Close_Click" Padding="4,0" Margin="0" ToolTip="Close monitor"/>
                <TextBlock Text="LIVE STATS  ·  drag to move" Foreground="#8AE1C3" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid x:Name="MetricsGrid" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="FpsLabel" Text="FPS" Foreground="#A4B3B9" Grid.Row="0" Grid.Column="0"/>
                <TextBlock x:Name="FpsValue" Text="—" TextAlignment="Right" FontWeight="SemiBold" Grid.Row="0" Grid.Column="1"/>
                <TextBlock x:Name="GpuLabel" Text="GPU" Foreground="#A4B3B9" Margin="0,5,0,0" Grid.Row="1" Grid.Column="0"/>
                <TextBlock x:Name="GpuValue" Text="—" TextAlignment="Right" Margin="0,5,0,0" FontWeight="SemiBold" Grid.Row="1" Grid.Column="1"/>
                <TextBlock x:Name="CpuLabel" Text="CPU" Foreground="#A4B3B9" Margin="0,5,0,0" Grid.Row="2" Grid.Column="0"/>
                <TextBlock x:Name="CpuValue" Text="—" TextAlignment="Right" Margin="0,5,0,0" FontWeight="SemiBold" Grid.Row="2" Grid.Column="1"/>
                <TextBlock x:Name="LatencyLabel" Text="Frame delay" Foreground="#A4B3B9" Margin="0,5,0,0" Grid.Row="3" Grid.Column="0"/>
                <TextBlock x:Name="LatencyValue" Text="—" TextAlignment="Right" Margin="0,5,0,0" FontWeight="SemiBold" Grid.Row="3" Grid.Column="1"/>
            </Grid>
            <TextBlock x:Name="FrameStatus" Text="" Foreground="#A4B3B9" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
