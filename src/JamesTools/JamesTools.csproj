<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JamesTools.Core\JamesTools.Core.csproj" />
    <ProjectReference Include="..\JamesTools.OcrWorker\JamesTools.OcrWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MehTools.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <AssemblyName>MehTools</AssemblyName>
    <Product>Meh Tools</Product>
    <Title>Meh Tools</Title>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\third_party\PresentMon\PresentMon.exe">
      <Link>tools\PresentMon\PresentMon.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\third_party\PresentMon\LICENSE.txt">
      <Link>tools\PresentMon\LICENSE-PresentMon.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildLiveWorker" AfterTargets="Build">
    <ItemGroup><LiveWorkerFiles Include="..\JamesTools.OcrWorker\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\*" /></ItemGroup>
    <Copy SourceFiles="@(LiveWorkerFiles)" DestinationFolder="$(TargetDir)tools\ocr" />
  </Target>
  <Target Name="PublishLiveWorker" AfterTargets="Publish">
    <MSBuild Projects="..\JamesTools.OcrWorker\JamesTools.OcrWorker.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)tools\ocr\" />
  </Target>
</Project>
