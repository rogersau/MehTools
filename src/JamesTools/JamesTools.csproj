<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JamesTools.Core\JamesTools.Core.csproj" />
    <ProjectReference Include="..\JamesTools.Mcp\JamesTools.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MehTools.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <AssemblyName>MehTools</AssemblyName>
    <Product>Meh Tools</Product>
    <Title>Meh Tools</Title>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\third_party\native-tools\win-x64\ffmpeg\*.exe">
      <Link>tools\ffmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\third_party\native-tools\win-x64\licenses\AOM-*.txt;..\..\third_party\native-tools\win-x64\licenses\FFmpeg-*.txt;..\..\third_party\native-tools\win-x64\licenses\COPYING.MinGW-w64-runtime.txt;..\..\third_party\native-tools\win-x64\licenses\zlib.txt;..\..\third_party\native-tools\win-x64\licenses\manifest.json;..\..\third_party\native-tools\win-x64\licenses\README.md">
      <Link>tools\licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\third_party\PresentMon\PresentMon.exe">
      <Link>tools\PresentMon\PresentMon.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\third_party\PresentMon\LICENSE.txt">
      <Link>tools\PresentMon\LICENSE-PresentMon.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireBundledNativeTools" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('..\..\third_party\native-tools\win-x64\ffmpeg\ffmpeg.exe') Or !Exists('..\..\third_party\native-tools\win-x64\ffmpeg\ffprobe.exe') Or !Exists('..\..\third_party\native-tools\win-x64\licenses\manifest.json') Or !Exists('..\..\artifacts\MehTools-native-sources.zip')" Text="Bundled tools or source materials are missing. Run pwsh -File scripts/Prepare-NativeTools.ps1 before publishing." />
  </Target>

  <Target Name="BuildMcpServer" AfterTargets="Build">
    <ItemGroup><McpServerFiles Include="..\JamesTools.Mcp\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\**\*" /></ItemGroup>
    <Copy SourceFiles="@(McpServerFiles)" DestinationFiles="@(McpServerFiles->'$(TargetDir)tools\mcp\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishMcpServer" AfterTargets="Publish">
    <MSBuild Projects="..\JamesTools.Mcp\JamesTools.Mcp.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)tools\mcp\" />
  </Target>
</Project>
