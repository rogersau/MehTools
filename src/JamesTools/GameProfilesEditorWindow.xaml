<Window x:Class="JamesTools.GameProfilesEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:JamesTools" ui:WindowTheme.Enabled="True"
        Title="Game profiles" Width="760" Height="650" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" >
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Content="Add profile" Click="Add_Click" Margin="0,2"/>
                <ui:ActionMenu x:Name="ProfileActions" Content="Profile actions" Visibility="Collapsed" Margin="0,2">
                    <ui:ActionMenu.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Duplicate profile" Click="Duplicate_Click"/>
                            <MenuItem Header="Delete profile" Click="Delete_Click"/>
                        </ContextMenu>
                    </ui:ActionMenu.ContextMenu>
                </ui:ActionMenu>
            </StackPanel>
            <ListBox x:Name="ProfileList" DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged"/>
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProfileEditor" Visibility="Collapsed">
                <TextBlock Text="Profile name" FontWeight="SemiBold"/>
                <TextBox x:Name="NameBox" Margin="0,5,0,14" TextChanged="ValueChanged"/>
                <TextBlock Text="Capture mode" FontWeight="SemiBold"/>
                <ComboBox x:Name="CaptureModeBox" Margin="0,5,0,14" SelectionChanged="ValueChanged"/>
                <TextBlock Text="Recording folder" FontWeight="SemiBold"/>
                <DockPanel Margin="0,5,0,14"><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/><TextBox x:Name="DirectoryBox" TextChanged="ValueChanged"/></DockPanel>
                <TextBlock Text="Replay length (15–600 seconds)" FontWeight="SemiBold"/>
                <TextBox x:Name="ReplayBox" Margin="0,5,0,14" TextChanged="ValueChanged"/>
                <TextBlock Text="Stop delay (0–120 seconds)" FontWeight="SemiBold"/>
                <TextBox x:Name="DelayBox" Margin="0,5,0,14" TextChanged="ValueChanged"/>
                <TextBlock Text="Vibrance (0–100%)" FontWeight="SemiBold"/>
                <TextBox x:Name="VibranceBox" Margin="0,5,0,14" TextChanged="ValueChanged"/>
                <TextBlock Text="Power plan" FontWeight="SemiBold"/>
                <ComboBox x:Name="PowerPlanBox" Margin="0,5,0,14" SelectionChanged="ValueChanged"/>
                <TextBlock Text="Leave a value blank or choose Inherit to use global settings." TextWrapping="Wrap" Foreground="#AAB6BE" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Use Save settings in the main window to apply profile changes." TextWrapping="Wrap" Foreground="#AAB6BE" Margin="0,16,0,10"/>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Done" IsDefault="True" MinWidth="90" Click="Done_Click"/>
        </StackPanel>
    </Grid>
</Window>
