<Window x:Class="JamesTools.PerformanceTimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:JamesTools" ui:WindowTheme.Enabled="True"
        Title="Performance report timeline" Width="1080" Height="820" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" >
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="100"/><RowDefinition Height="1.3*" MinHeight="140" MaxHeight="270"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ReportTitle" Text="Performance report" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,4,0,7" Foreground="#AEBBC0"/>
        </StackPanel>
        <Expander Grid.Row="1" Header="Time range and exclusions" Margin="0,4,0,8" Padding="0,6,0,0"><StackPanel>
            <WrapPanel VerticalAlignment="Top">
                <TextBlock Text="Range (s)" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="RangeStart" Width="85" Margin="0,0,6,0"/>
                <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="RangeEnd" Width="85" Margin="0,0,6,0"/>
                <Button Content="Apply range" Click="ApplyRange_Click"/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="Exclude (s)" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="ExcludeStart" Width="58" ToolTip="Excluded start (s)"/>
                <TextBlock Text="to" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="ExcludeEnd" Width="58" ToolTip="Excluded end (s)"/>
                <TextBlock Text="Reason" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="ExcludeReason" Width="110" ToolTip="Reason e.g. loading or alt-tab"/>
                <Button Content="Exclude interval" Click="AddExclusion_Click"/>
            </WrapPanel>
            <DockPanel x:Name="ExclusionsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <Button Content="Remove exclusion" DockPanel.Dock="Right" Click="RemoveExclusion_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=ExclusionList}" Value="-1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ListBox x:Name="ExclusionList" MaxHeight="64" DisplayMemberPath="Display"/>
            </DockPanel>
        </StackPanel></Expander>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="StutterPanel" Margin="0,0,0,12">
                    <TextBlock Text="Worst stutters - select an event to inspect the surrounding five seconds" FontWeight="SemiBold"/>
                    <ComboBox x:Name="StutterList" DisplayMemberPath="Display" SelectionChanged="StutterList_SelectionChanged" Margin="0,6,0,6"/>
                    <TextBlock x:Name="StutterText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Canvas x:Name="StutterPlot" Height="180" Background="#202B30" SizeChanged="Plot_SizeChanged"/>
                    <DataGrid x:Name="StutterHardware" Height="160" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
                </StackPanel>
                <StackPanel x:Name="NetworkPanel">
                <TextBlock Text="ICMP network observations · retained samples, no interpolation" FontWeight="SemiBold"/>
                <ComboBox x:Name="NetworkTarget" SelectionChanged="NetworkTarget_SelectionChanged"/>
                <TextBlock x:Name="NetworkSummary" TextWrapping="Wrap"/>
                <Canvas x:Name="NetworkPlot" Height="145" Background="#202B30" SizeChanged="Plot_SizeChanged"/>
                <DataGrid x:Name="NetworkTable" Height="130" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
                </StackPanel>
                <Canvas x:Name="FramePlot" Height="145" Background="#202B30" Margin="0,2,0,3" SizeChanged="Plot_SizeChanged"/>
                <Canvas x:Name="CpuGpuPlot" Height="145" Background="#202B30" Margin="0,2,0,3" SizeChanged="Plot_SizeChanged"/>
                <Canvas x:Name="MemoryPlot" Height="145" Background="#202B30" Margin="0,2,0,3" SizeChanged="Plot_SizeChanged"/>
                <Canvas x:Name="DiskPlot" Height="145" Background="#202B30" Margin="0,2,0,3" SizeChanged="Plot_SizeChanged"/>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="3" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="MarkersPanel">
                <TextBlock Text="Markers (select a stutter to zoom ±10 s)" FontWeight="SemiBold"/>
                <ListBox x:Name="MarkerList" Height="132" SelectionChanged="MarkerList_SelectionChanged" DisplayMemberPath="Display"/>
            </StackPanel>
            <StackPanel x:Name="ReportDetails" Grid.Column="1" Margin="12,0,0,0">
                <ScrollViewer Height="108" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnalysisText" TextWrapping="Wrap"/>
                </ScrollViewer>
                <DataGrid x:Name="SampleTable" Height="105" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
            </StackPanel>
        </Grid></ScrollViewer>
    </Grid>
</Window>
