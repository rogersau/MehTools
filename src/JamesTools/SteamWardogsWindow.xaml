<Window x:Class="JamesTools.SteamWardogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JamesTools" ui:WindowTheme.Enabled="True"
        Title="Steam WARDOGS highlights" Width="900" Height="640" MinWidth="650" MinHeight="510"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="125"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Steam WARDOGS highlights" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Game events come from Steam’s timeline. Steam records the footage, and Meh Tools matches it to the event." Style="{StaticResource Hint}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                <DockPanel LastChildFill="True">
                    <Button x:Name="BrowseFolder" DockPanel.Dock="Right" Content="Choose folder…" Click="Browse_Click" Margin="8,0,0,0"/>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0"/>
                    <TextBlock x:Name="FolderLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Steam session" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="TimelineBox" DisplayMemberPath="Label" SelectionChanged="Selection_Changed" AutomationProperties.Name="Steam session"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Event filter" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="Selection_Changed" AutomationProperties.Name="Event filter">
                    <ComboBoxItem Content="All game events"/>
                    <ComboBoxItem Content="Kills"/>
                    <ComboBoxItem Content="Kill assists"/>
                    <ComboBoxItem Content="Revives and respawns"/>
                    <ComboBoxItem Content="Other events"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button x:Name="UseShownEventsButton" Content="Use only shown" Click="UseShownEvents_Click"/>
            <Button x:Name="IncludeShownEventsButton" Content="Include shown" Click="IncludeShownEvents_Click"/>
            <Button x:Name="ClearEventsButton" Content="Clear selection" Click="ClearEvents_Click"/>
            <TextBlock x:Name="SelectedEventCount" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </WrapPanel>
        <DataGrid Grid.Row="3" x:Name="EventsTable" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False"
                  SelectionChanged="Event_Changed" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="INCLUDE" Width="94" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Included, Mode=OneWay}"
                                      IsEnabled="{Binding Event.HasFootage}" Click="EventIncluded_Click"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="Include event in highlights"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="TIME IN SESSION" Binding="{Binding Time}" SortMemberPath="Event.TimelineMs" Width="138"/>
                <DataGridTextColumn Header="EVENT" Binding="{Binding Event.Title}" Width="1.3*"/>
                <DataGridTextColumn Header="DETAILS" Binding="{Binding Event.Description}" Width="2*"/>
                <DataGridTextColumn Header="FOOTAGE" Binding="{Binding Coverage}" Width="125"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="MontageButton" Content="Save highlights video…" Click="Montage_Click" IsEnabled="False"/>
                <Button x:Name="PreviewButton" Content="Preview event" Click="Preview_Click" IsEnabled="False"/>
                <Button x:Name="ExportButton" Content="Save MP4 clip…" Click="Export_Click" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock x:Name="PaddingText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock x:Name="SteamStatus" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>
