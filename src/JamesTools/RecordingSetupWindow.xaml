<Window x:Class="JamesTools.RecordingSetupWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JamesTools" ui:WindowTheme.Enabled="True"
        Title="Set up game recording" Width="650" Height="660" MinWidth="480" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="DetectObs_Loaded">
    <Window.Resources>
        <Style x:Key="SetupCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Automatic game recording" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Meh Tools starts OBS to record when you open the chosen game, then closes it when you finish playing."
                           Style="{StaticResource Hint}" Margin="0,6,0,4"/>
                <TextBlock Text="Starting watching also applies any other features and game rules you've enabled."
                           Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                <Border Style="{StaticResource SetupCard}"><StackPanel>
                    <TextBlock Text="Game" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedGameText" Text="Choose your first game." TextWrapping="Wrap" Margin="0,5,0,8"/>
                    <WrapPanel>
                        <Button Content="Find open game" Click="FindGame_Click"/>
                        <Button Content="Browse for game…" Click="BrowseGame_Click"/>
                    </WrapPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource SetupCard}"><StackPanel>
                    <TextBlock Text="OBS Studio" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedObsText" Text="Looking for OBS Studio…" TextTrimming="CharacterEllipsis" Margin="0,5,0,6"/>
                    <TextBlock Text="In OBS, add a visible Game Capture source to the active scene. Close OBS to save the scene and let Meh Tools start recording."
                               Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="FindObsButton" Content="Find OBS" Click="FindObs_Click"/>
                        <Button Content="Browse for OBS…" Click="BrowseObs_Click"/>
                        <Button Content="Get OBS Studio" Click="GetObs_Click"/>
                    </WrapPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource SetupCard}"><StackPanel>
                    <TextBlock Text="Default video folder" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedFolderText" TextTrimming="CharacterEllipsis" Margin="0,5,0,8"/>
                    <Button Content="Choose folder…" Click="ChooseFolder_Click" HorizontalAlignment="Left"/>
                </StackPanel></Border>
                <TextBlock x:Name="SetupError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#F0A491" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="Open advanced settings" Click="Advanced_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Save and start watching" Click="Save_Click" IsDefault="True" Style="{StaticResource AccentButton}"/>
        </WrapPanel>
    </Grid>
</Window>
